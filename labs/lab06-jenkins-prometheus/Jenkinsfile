pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Build') {
            steps {
                echo 'Compilando Core (lab01 Modulith) — pipeline autônoma do componente Java'
                sh '''
                    set -e
                    cd /workspace/labs/lab01-spring-modulith
                    mvn -B -DskipTests package
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Suíte Modulith / ModularityTests'
                sh '''
                    set -e
                    cd /workspace/labs/lab01-spring-modulith
                    mvn -B test
                '''
            }
        }

        stage('Quality Gate') {
            steps {
                echo 'Quality Gate: falha de teste bloqueia a promoção (ASR-11).'
                script {
                    def failed = currentBuild.currentResult == 'UNSTABLE' || currentBuild.currentResult == 'FAILURE'
                    if (failed) {
                        error('Quality Gate BLOQUEADO — artefato NÃO promovido (ASR-11).')
                    }
                    echo 'Quality Gate OK — promovendo artefato do Core.'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline Core verde. Deploy autorizado apenas para este componente.'
        }
        failure {
            echo 'Pipeline Core vermelho. Nenhum artefato promovido.'
        }
    }
}
