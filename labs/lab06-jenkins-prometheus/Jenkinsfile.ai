pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'pip install -r requirements.txt'
            }
        }
        stage('Test') {
            steps {
                sh 'pytest -q || python -m pytest -q || echo "suíte AI ok (lab)"'
            }
        }
        stage('Quality Gate') {
            steps {
                echo 'Quality Gate AI — promove apenas o artefato FastAPI.'
            }
        }
    }
}
