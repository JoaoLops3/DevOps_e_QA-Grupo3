pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Build') {
            steps {
                echo 'Validando artefato FastAPI / demo Circuit Breaker (componente AI)'
                sh '''
                    set -e
                    export PYTHONDONTWRITEBYTECODE=1
                    python3 -m py_compile /workspace/labs/lab03-python-circuitbreaker/core_circuit_breaker_demo.py
                    test -f /workspace/labs/lab03-python-circuitbreaker/ai-service/main.py
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Suíte AI do laboratório (isolada do Core Java)'
                sh '''
                    set -e
                    export PYTHONDONTWRITEBYTECODE=1
                    python3 -c "import ast; ast.parse(open('/workspace/labs/lab03-python-circuitbreaker/core_circuit_breaker_demo.py').read())"
                    echo "AI suite lab ok"
                '''
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    if (currentBuild.currentResult == 'UNSTABLE' || currentBuild.currentResult == 'FAILURE') {
                        error('Quality Gate AI BLOQUEADO — artefato FastAPI NÃO promovido (ASR-11).')
                    }
                    echo 'Quality Gate AI OK — promove apenas o artefato FastAPI.'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline AI verde. Core e Gateway não foram acoplados a este job.'
        }
        failure {
            echo 'Pipeline AI vermelha. Nenhum artefato AI promovido.'
        }
    }
}
